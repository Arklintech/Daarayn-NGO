# Copy to .env.local and fill in. Never commit real values. Names are the ones the code reads.

# --- Firebase Authentication (client config is public by design; server verifies tokens) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
FIREBASE_PROJECT_ID=

# Comma-separated admin emails (must be verified Firebase accounts)
ADMIN_EMAILS=

# --- Google Sheets + Drive (one service account) ---
# Local: absolute path to the service-account JSON (kept out of Git by .gitignore: daaraynorg-*.json)
GOOGLE_APPLICATION_CREDENTIALS=
# Deployment alternative to the file: set both of these instead
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Spreadsheet to use (use a TEST spreadsheet for tests) and the Drive evidence folder
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Google Drive OAuth (server-side; uploads run as the authorised Google account, Sheets keeps the service account)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must equal the callback route exactly, e.g. http://localhost:3000/api/admin/google-drive/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Optional: provide the refresh token yourself instead of using Admin -> Settings -> Connect
GOOGLE_DRIVE_REFRESH_TOKEN=
# Production: base64 of 32 random bytes; keeps the token encrypted in the _Secrets sheet tab
DRIVE_TOKEN_ENCRYPTION_KEY=
# "testing" (default) or "production": set production only after the OAuth consent screen is published; Testing-mode tokens expire after 7 days
GOOGLE_OAUTH_PUBLISHING_STATUS=testing
# Optional: separate Drive folder id for integration tests (never the production folder)
GOOGLE_DRIVE_TEST_FOLDER_ID=

# --- Gmail SMTP via Nodemailer ---
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Gmail App Password (16 characters)
SMTP_PASS=
FROM_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional ---
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
